# Canonical origin used for metadata, sitemap and robots.
# Leave unset locally: the app falls back to http://localhost:3000 in dev and to
# VERCEL_PROJECT_PRODUCTION_URL on Vercel.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery.
# Any endpoint that accepts a JSON POST: an email service, a webhook, a CRM.
# If this is empty in production the form returns 503 and the UI shows the email
# address instead. That is on purpose: a form must never report success while
# dropping the lead.
CONTACT_WEBHOOK_URL=

# Private panel (/panel). See docs/LIFE_CRM.md.
# The publishable key is public by design: Row Level Security does the gating.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated. Only these accounts can open the panel. Empty = closed.
PANEL_ALLOWED_EMAILS=

# Chat del panel (/panel/ia). Sin ella, el chat avisa y el resto funciona.
GEMINI_API_KEY=

# Las solicitudes de /diagnostico se guardan en la tabla `leads` del proyecto
# de Supabase de arriba: no hace falta configurar nada más para que funcionen.
# CONTACT_WEBHOOK_URL es opcional y solo añade un aviso (Slack, Make, correo).
